# Consumed by docker-compose.yml. Copy to .env and adjust before running
# `docker compose up`. For non-Docker local development, see
# backend/.env.example and frontend/.env.example instead.

POSTGRES_USER=gateway_user
POSTGRES_PASSWORD=change_me
POSTGRES_DB=gateway_db

# Optional Supabase connection overrides. Uncomment both to use Supabase;
# URL-encode special characters in the password (for example, # as %23).
# DATABASE_URL=postgresql://postgres.<project-ref>:<password>@<region>.pooler.supabase.com:6543/postgres?pgbouncer=true
# DIRECT_URL=postgresql://postgres.<project-ref>:<password>@<region>.pooler.supabase.com:5432/postgres

JWT_SECRET_KEY=replace_with_a_long_random_secret
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

DEFAULT_RATE_LIMIT_TOKENS=100
DEFAULT_RATE_LIMIT_REFILL_PER_SEC=1.0

ENVIRONMENT=development
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# Must match whatever port the backend container is published on,
# since this gets baked into the frontend's JS bundle at build time.
VITE_API_BASE_URL=http://localhost:8000
